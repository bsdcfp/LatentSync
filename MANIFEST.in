include README.md
include LICENSE
include requirements.txt
include pyproject.toml
include *.py
include *.sh
include *.md
recursive-include productscene *
recursive-include examples *
recursive-include test *
recursive-include scripts *
recursive-include upload_tool *
global-exclude *.pyc
global-exclude __pycache__
global-exclude *.pyo
global-exclude *.pyd
global-exclude .git*
global-exclude .DS_Store
global-exclude *.egg-info
global-exclude output/*
global-exclude tmp_results/*
global-exclude log/*
global-exclude models/*
global-exclude build_env/* 